# =====================================================================
# EXILE — EXiled Intelligence, Liberated from Everything
# Your AI. Your PC. Your rules.
#
# Copy this file to  .env  and fill in your keys.
# MINIMUM: 2 keys.   MAXIMUM: 200 keys (any *_API_KEY is auto-detected).
# =====================================================================

# ---- point the UI at the local API server (leave as-is) -------------
VITE_EXILE_LOCAL_API=http://localhost:8787
EXILE_PORT=8787

# ---- preferred provider (optional): openai | groq | openrouter |
#      together | deepseek | mistral | xai | perplexity | gemini | lovable
EXILE_PRIMARY_PROVIDER=groq

# ---- core chat providers (fill at least 2) --------------------------
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=
LOVABLE_API_KEY=

# ---- optional model overrides ---------------------------------------
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-2.5-flash

# ---- fully offline brain (no key needed) ----------------------------
# Install Ollama from https://ollama.com then:  ollama pull llama3.2
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ---- voice (optional) ------------------------------------------------
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# ---- home / vehicle control (optional) -------------------------------
HOME_ASSISTANT_URL=
HOME_ASSISTANT_API_KEY=
TESLA_API_KEY=
SMARTCAR_API_KEY=

# ---- comms (optional) -------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
WHATSAPP_API_KEY=

# ---- search / research (optional) -------------------------------------
TAVILY_API_KEY=
SERPAPI_API_KEY=
BRAVE_API_KEY=
FIRECRAWL_API_KEY=

# ---- persona ----------------------------------------------------------
# EXILE_SYSTEM_PROMPT=You are EXILE...
