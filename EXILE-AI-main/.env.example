# Copy to .env (never commit .env). Values come from Supabase dashboard -> Project Settings -> API.
# Only the PUBLISHABLE (anon) key belongs here; never put a service-role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: base URL of the local EXILE server if it is not on 127.0.0.1:8787-8789.
# VITE_EXILE_LOCAL_API=
